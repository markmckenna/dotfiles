#!/bin/bash
#
# Dotfiles management code. Basically a wrapper around git that disables some sensitive commands.
# Regular git commands don't work because the git metadata doesn't live at .git, so this gives us
# a decent place to protect things from.

dot() {
  case "$1" in
    clean)
      print -u2 "dot: clean disabled — would delete untracked files across \$HOME"
      return 1
      ;;
    add)
      local a
      for a in "${@:2}"; do
        case "$a" in
          .|-A|--all|:/)
            print -u2 "dot: refusing '$a' — add dotfiles by explicit path"
            return 1
            ;;
        esac
      done
      ;;
  esac
  command git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" "$@"
}